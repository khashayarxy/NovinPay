APP_NAME="NovinPay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Production hardening (set these in the server's .env, never commit them)
# ---------------------------------------------------------------------------
#   APP_ENV=production
#   APP_DEBUG=false          # NEVER true in production — hides stack traces
#   APP_URL=https://your-domain.com
#                            # When APP_URL starts with https://, generated
#                            # URLs are forced to the https scheme. HTTP->HTTPS
#                            # redirects must be enabled at the host/proxy layer.
# SESSION_SECURE_COOKIE=true # Mark the session cookie HTTPS-only (SSL required)

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is used as a temporary, explicitly documented local development
# database (no MySQL/MariaDB server is available in the current environment).
# The intended production database is MySQL or MariaDB. Before deploying,
# switch DB_CONNECTION to mysql/mariadb and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=novinpay
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Admin panel (single account, no public registration)
# ---------------------------------------------------------------------------
# Used by: php artisan db:seed --class=AdminUserSeeder
# Read via config('admin.*') so it survives `php artisan config:cache`.
# Never commit a real .env with actual values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Failed-login ceiling per IP across all emails (per-email ceiling is 5/60s).
ADMIN_LOGIN_IP_MAX_ATTEMPTS=30
