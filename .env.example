APP_NAME="NovinPay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Production hardening (set these in the server's .env, never commit them)
# ---------------------------------------------------------------------------
#   APP_ENV=production
#   APP_DEBUG=false          # NEVER true in production — hides stack traces
#   APP_URL=https://your-domain.com
#                            # When APP_URL starts with https://, generated
#                            # URLs are forced to the https scheme. HTTP->HTTPS
#                            # redirects must be enabled at the host/proxy layer.
# SESSION_SECURE_COOKIE=true # Mark the session cookie HTTPS-only (SSL required)

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is used as a temporary, explicitly documented local development
# database (no MySQL/MariaDB server is available in the current environment).
# The intended production database is MySQL or MariaDB. Before deploying,
# switch DB_CONNECTION to mysql/mariadb and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=novinpay
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Admin panel (single account, no public registration)
# ---------------------------------------------------------------------------
# Used by: php artisan db:seed --class=AdminUserSeeder
# Read via config('admin.*') so it survives `php artisan config:cache`.
# Never commit a real .env with actual values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Failed-login ceiling per IP across all emails (per-email ceiling is 5/60s).
ADMIN_LOGIN_IP_MAX_ATTEMPTS=30

# Customer services: remain disabled until separately configured and approved.
SMSIR_ENABLED=false
SMS_PROVIDER=smsir
IPPANEL_ENABLED=false
IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_PATTERN_PARAMETER=
IPPANEL_SENDER=
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
# Exact parameter spelling from the approved provider template (no default).
SMSIR_OTP_PARAMETER=
# Comma-separated IDs only after approval AND parameter review in SMS.ir.
SMSIR_APPROVED_TEMPLATE_IDS=
SMSIR_NOTIFICATIONS_ENABLED=false
SMSIR_NOTIFICATION_PARAMETER=
SMSIR_TEMPLATE_REPAIR_REGISTERED=
SMSIR_TEMPLATE_DEVICE_RECEIVED=
SMSIR_TEMPLATE_QUOTATION_AVAILABLE=
SMSIR_TEMPLATE_REPAIR_COMPLETED=
SMSIR_TEMPLATE_PAYMENT_CONFIRMED=
SMSIR_TEMPLATE_PICKUP_READY=
SMSIR_TEMPLATE_DEVICE_SHIPPED=

# No real gateway traffic is authorized by local development.
ZIBAL_ENABLED=false
ZIBAL_LIVE_REQUESTS=false
ZIBAL_MERCHANT_ID=
ZIBAL_CALLBACK_URL=
ZIBAL_API_BASE_URL=https://gateway.zibal.ir
BANK_TRANSFER_ENABLED=false
NOVINPAY_BANK_CARD=
NOVINPAY_BANK_HOLDER=

# Private support chat is provisioned separately; external transports stay disabled.
SUPPORT_CHAT_ENABLED=false
CUSTOMER_TEST_OTP_ENABLED=false
CUSTOMER_TEST_OTP_PHONES=
CUSTOMER_TEST_RESET_ON_LOGOUT=true
