APP_NAME="NovinPay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Production hardening (set these in the server's .env, never commit them)
# ---------------------------------------------------------------------------
#   APP_ENV=production
#   APP_DEBUG=false          # NEVER true in production — hides stack traces
#   APP_URL=https://your-domain.com
#                            # When APP_URL starts with https://, generated
#                            # URLs are forced to the https scheme. HTTP->HTTPS
#                            # redirects must be enabled at the host/proxy layer.
# SESSION_SECURE_COOKIE=true # Mark the session cookie HTTPS-only (SSL required)

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is used as a temporary, explicitly documented local development
# database (no MySQL/MariaDB server is available in the current environment).
# The intended production database is MySQL or MariaDB. Before deploying,
# switch DB_CONNECTION to mysql/mariadb and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=novinpay
# DB_USERNAME=root
# DB_PASSWORD=

# Use local SSD file storage for sessions and cache on shared cPanel hosting
# to prevent MariaDB row/gap lock contention on `sessions`, `cache`, and `cache_locks`.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Admin panel (single account, no public registration)
# ---------------------------------------------------------------------------
# Used by: php artisan db:seed --class=AdminUserSeeder
# Read via config('admin.*') so it survives `php artisan config:cache`.
# Never commit a real .env with actual values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Failed-login ceiling per IP across all emails (per-email ceiling is 5/60s).
ADMIN_LOGIN_IP_MAX_ATTEMPTS=30

# Customer services: remain disabled until separately configured and approved.
SMS_PROVIDER=ippanel
IPPANEL_ENABLED=false
IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_PATTERN_PARAMETER=
IPPANEL_SENDER=

# No real gateway traffic is authorized by local development.
ZIBAL_ENABLED=false
ZIBAL_LIVE_REQUESTS=false
ZIBAL_MERCHANT_ID=
# Production callback: https://novinpaypos.com/payments/zibal/callback
ZIBAL_CALLBACK_URL=
# Optional comma-separated exact IPs of verified ingress proxies for payment connectivity only.
PAYMENTS_TRUSTED_PROXY_IPS=
ZIBAL_API_BASE_URL=https://gateway.zibal.ir
BANK_TRANSFER_ENABLED=false
NOVINPAY_BANK_CARD=
NOVINPAY_BANK_HOLDER=
# Private 5,000 Toman payment-gateway test product (keep allowed phones empty unless explicitly enabled).
PAYMENT_TEST_PRODUCT_SLUG=zibal-gateway-test-5000
PAYMENT_TEST_ALLOWED_PHONES=

# Private support chat is provisioned separately; external transports stay disabled.
SUPPORT_CHAT_ENABLED=false
CUSTOMER_TEST_OTP_ENABLED=false
CUSTOMER_TEST_OTP_PHONES=
CUSTOMER_TEST_SMS_PHONE=

# Unified notification channels (auto-enabled for Admin SMS/Email when NOTIFICATIONS_ADMIN_PHONES / NOTIFICATIONS_ADMIN_EMAILS are populated, unless explicitly set to false).
NOTIFICATIONS_ADMIN_PHONES=
NOTIFICATIONS_ADMIN_EMAILS=
NOTIFICATIONS_SMS_ENABLED=
NOTIFICATIONS_ADMIN_SHARED_PATTERN_FALLBACK=true
# The nine order and repair patterns use SMS_PROVIDER and IPPANEL credentials by default.
# In production with IPPanel, set these overrides to ippanel and true, respectively.
# Blank overrides inherit the provider and its enablement. IPPANEL_PATTERN_CODE and IPPANEL_PATTERN_PARAMETER are for OTP only.
NOTIFICATIONS_PATTERN_SMS_PROVIDER=
NOTIFICATIONS_PATTERN_SMS_ENABLED=
# Dedicated credentials apply only when NOTIFICATIONS_PATTERN_SMS_PROVIDER=panelchi.
NOTIFICATIONS_PANELCHI_ENABLED=false
NOTIFICATIONS_PANELCHI_API_KEY=
NOTIFICATIONS_PANELCHI_SENDER=
NOTIFICATIONS_SMS_PATTERN_ORDER_CONFIRMED=mfae2yqje8msw9e
NOTIFICATIONS_SMS_PATTERN_ORDER_PREPARING=694jmegiuep02i6
NOTIFICATIONS_SMS_PATTERN_ORDER_SHIPPED=yksd5440vew1loy
NOTIFICATIONS_SMS_PATTERN_REPAIR_CREATED=309p3u2jo5b7qds
# Optional method-specific repair creation SMS patterns (automatically fall back to REPAIR_CREATED when empty)
NOTIFICATIONS_SMS_PATTERN_REPAIR_CREATED_IN_PERSON=
NOTIFICATIONS_SMS_PATTERN_REPAIR_CREATED_POSTAL=
NOTIFICATIONS_SMS_PATTERN_REPAIR_CREATED_COURIER=
NOTIFICATIONS_SMS_PATTERN_REPAIR_PAYMENT=a7h9o09htzyjk17
NOTIFICATIONS_SMS_PATTERN_REPAIR_STATUS=hn7sgk679tfdxvt
NOTIFICATIONS_SMS_PATTERN_ORDER_PICKUP_READY=u2fc816s2qo1u5t
NOTIFICATIONS_SMS_PATTERN_ORDER_CANCELLED=xtawhyckra6k1tt
NOTIFICATIONS_SMS_PATTERN_REPAIR_CANCELLED=8zvy6p1t482z3oy
NOTIFICATIONS_EMAIL_ENABLED=
# Optional dedicated admin SMS pattern codes (when blank, order/repair admin SMS safely falls back to ORDER_CONFIRMED / REPAIR_CREATED)
NOTIFICATIONS_IPPANEL_PATTERN_ADMIN_ORDER=
NOTIFICATIONS_IPPANEL_PATTERN_ADMIN_ORDER_PAID=
NOTIFICATIONS_IPPANEL_PATTERN_ADMIN_REPAIR=
NOTIFICATIONS_IPPANEL_PATTERN_ADMIN_CONSULTATION=
NOTIFICATIONS_IPPANEL_PATTERN_ADMIN_CHAT_FIRST=
NOTIFICATIONS_IPPANEL_PATTERN_CUSTOMER_ORDER_PLACED=
NOTIFICATIONS_IPPANEL_PATTERN_CUSTOMER_ORDER_SHIPPED=
NOTIFICATIONS_IPPANEL_PATTERN_CUSTOMER_REPAIR_SUBMITTED=
NOTIFICATIONS_IPPANEL_PATTERN_CUSTOMER_REPAIR_STATUS=
NOTIFICATIONS_IPPANEL_PATTERN_CUSTOMER_CONSULTATION=
NOTIFICATIONS_BALE_ENABLED=false
NOTIFICATIONS_BALE_BOT_TOKEN=
NOTIFICATIONS_BALE_CHAT_ID=
NOTIFICATIONS_BALE_API_BASE=https://tapi.bale.ai
# Legacy single-channel Telegram alerts (fallback when TELEGRAM_TOPICS_ENABLED=false)
NOTIFICATIONS_TELEGRAM_ENABLED=false
NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
NOTIFICATIONS_TELEGRAM_CHAT_ID=
# Optional proxy/Cloudflare Worker base URL for Iran-hosted servers (default: https://api.telegram.org)
NOTIFICATIONS_TELEGRAM_API_BASE=https://api.telegram.org

# Phase 7: Three-path authentication (Email OTP/Password + Google OAuth)
CUSTOMER_EMAIL_AUTH_ENABLED=true
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CUSTOMER_TEST_RESET_ON_LOGOUT=true

# Observability, daily log retention, 2x-daily encrypted DB backups & Telegram Forum Topics
LOG_DAILY_DAYS=14
LOG_PAYMENTS_DAYS=30
LOG_SMS_DAYS=30
LOG_FRONTEND_DAYS=14
LOG_PERFORMANCE_DAYS=14
OBSERVABILITY_CLIENT_TELEMETRY_ENABLED=false
OBSERVABILITY_SLOW_REQUEST_MS=2000
OBSERVABILITY_SLOW_QUERY_MS=500
OBSERVABILITY_LOW_STOCK_THRESHOLD=3
OBSERVABILITY_BACKUP_PATH=
OBSERVABILITY_BACKUP_MAX_AGE_HOURS=72
OBSERVABILITY_SCHEDULED_DB_BACKUP_ENABLED=true
OBSERVABILITY_BACKUP_PASSPHRASE=
OBSERVABILITY_BACKUP_KEY_FILE=/home/novinpay/.novinpay-maint10-key
OBSERVABILITY_BACKUP_RETAIN_COUNT=6
TELEGRAM_TOPICS_ENABLED=false
TELEGRAM_TOPICS_BOT_TOKEN=
TELEGRAM_TOPICS_CHAT_ID=
# Optional proxy/Cloudflare Worker base URL; falls back to NOTIFICATIONS_TELEGRAM_API_BASE if unset
TELEGRAM_TOPICS_API_BASE=
TELEGRAM_TOPICS_THROTTLE_SECONDS=300
TELEGRAM_TOPICS_FALLBACK_TO_GENERAL=true
TELEGRAM_TOPIC_PAYMENTS_ID=
TELEGRAM_TOPIC_ORDERS_ID=
TELEGRAM_TOPIC_REPAIRS_ID=
TELEGRAM_TOPIC_USERS_ID=
TELEGRAM_TOPIC_SMS_ID=
TELEGRAM_TOPIC_INVENTORY_ID=
TELEGRAM_TOPIC_ERRORS_ID=
TELEGRAM_TOPIC_BACKUPS_ID=
TELEGRAM_TOPIC_PERFORMANCE_ID=
TELEGRAM_TOPIC_DIGEST_ID=
TELEGRAM_TOPIC_CONSULTATIONS_ID=
TELEGRAM_TOPIC_SUPPORT_CHAT_ID=
TELEGRAM_TOPIC_REVIEWS_ID=
TELEGRAM_TOPIC_DOCUMENTS=

# Post-purchase AES-256 activation documents & IPPanel workflow patterns
DOCS_ZIP_PASSWORD=
DOCS_RETENTION_DAYS=7
IPPANEL_PATTERN_DOCUMENTS_REVISION=
IPPANEL_PATTERN_DOCUMENTS_APPROVED=
IPPANEL_PATTERN_CONSULTATION_SUBMITTED=
